{
  "name": "md-wechat",
  "private": true,
  "version": "0.1.0",
  "description": "面向公众号写作者的 Markdown 排版工具：实时预览、26 套主题、一键复制富文本",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "dev:ensure": "node scripts/ensure-dev.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "check:extension": "node scripts/check-extension.mjs",
    "writer:publish": "node scripts/writer-publish.mjs",
    "writer:public": "node scripts/publish-public-article.mjs",
    "writer:public:deploy": "node scripts/publish-public-deploy.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "codemirror": "^6.0.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-mark": "^4.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7",
    "zod": "^4.4.3"
  }
}
